# Frontend Supabase credentials (Anon / Public key only)
# Never place service_role key or LLM API keys in VITE_ variables!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side Edge Function secrets (Do NOT expose to browser)
# In Supabase Edge Functions, set via: supabase secrets set DEEPSEEK_API_KEY=...
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
